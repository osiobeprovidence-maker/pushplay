# Public Convex site URL used by the React client (safe to expose).
# Set this in Vercel project env vars too: https://vercel.com/<project>/settings/environment-variables
# Client WebSocket/HTTP endpoint (.convex.cloud — NOT .convex.site, which is
# only for HTTP actions and will be rejected by ConvexReactClient).
VITE_CONVEX_URL=https://wooden-rooster-817.eu-west-1.convex.cloud

# Set to "true" only AFTER the Convex backend is deployed (npx convex deploy).
VITE_CONVEX_DEPLOYED=false

# Firebase web config — set these in Vercel project env vars (they ship to the client).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=usepushplay.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=usepushplay
VITE_FIREBASE_STORAGE_BUCKET=usepushplay.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=596112499041
VITE_FIREBASE_APP_ID=1:596112499041:web:38ab37d855a0ec50836520
VITE_FIREBASE_MEASUREMENT_ID=G-1FH5TLRV1B
